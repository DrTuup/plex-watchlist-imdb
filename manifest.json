{
  "manifest_version": 3,
  "name": "Plex Watchlist for IMDb",
  "version": "0.1.0",
  "description": "Add the IMDb movie or series you're viewing to your Plex watchlist.",
  "browser_specific_settings": {
    "gecko": {
      "id": "plex-watchlist-imdb@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo", "websiteContent"]
      }
    }
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.imdb.com/*",
    "https://discover.provider.plex.tv/*",
    "https://plex.tv/*",
    "https://app.plex.tv/*"
  ],
  "background": {
    "scripts": ["src/background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.imdb.com/title/*"],
      "js": ["src/content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Add to Plex watchlist",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "src/popup.html"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  }
}
